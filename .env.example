# Copy to .env.local for local development. Everything is optional except where noted.

# Public address of the site (used for canonical links, sitemap and Open Graph).
# On Vercel this falls back to the production domain automatically.
SITE_URL=http://localhost:3000

# Google Gemini key for the kitchen helper, swaps and AI recipes (https://aistudio.google.com/apikey).
# Without it the AI features show "not set up" in production and use canned answers in development.
GEMINI_API_KEY=
# Model id. Default: gemini-3.5-flash-lite (fast and cheap).
GEMINI_MODEL=
# Backup model, used when Google says the main one is busy. Default: gemini-flash-latest.
GEMINI_FALLBACK_MODEL=

# TheMealDB key. "1" is the free test key; get a supporter key before you make money from the site.
MEALDB_API_KEY=1

# Postgres (Neon) for shared rate limits across server instances. Without it limits are per instance.
DATABASE_URL=

# Max AI requests per day for the whole site (protects your Gemini bill). Default 1500.
AI_DAILY_LIMIT=

# Optional: Google Analytics 4 measurement id (G-XXXXXXX).
NEXT_PUBLIC_GA_ID=
# Optional: Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=
# Optional: Google AdSense. Client id (ca-pub-...) turns on ads.txt and the ad slots below.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_RECIPE=
NEXT_PUBLIC_ADSENSE_SLOT_SEARCH=

# Test/dev only: serve recipes from tests/fixtures instead of TheMealDB, and canned AI answers.
BITEBOX_SAMPLE_DATA=
BITEBOX_AI_MOCK=
